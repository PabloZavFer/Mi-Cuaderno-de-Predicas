<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: la copia de seguridad automática de Android incluye la base de datos
     y los ajustes; los PDF temporales (caché) no se respaldan. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
